// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MagicCode {
  email   String   @unique
  code    String
  expires DateTime

  @@map("magic_code")
}

/// A company using the DMS
model Company {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
  users     User[]    @relation("CompanyUsers")
}

/// A project within a company
model Project {
  id        String   @id @default(cuid())
  name      String
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  users     User[]   @relation("members")
  Spaces    Space[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Space {
  id        String      @id @default(cuid())
  name      String
  repo      Repository?
  tasks     Task[]
  members   User[]      @relation("SpaceMembers")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project?    @relation(fields: [projectId], references: [id])
  projectId String?
}

/// Users in the system
model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  avatarUrl String?
  role      UserRole      @default(MEMBER)
  Company   Company[]     @relation("CompanyUsers")
  prs       PullRequest[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  Tasks     Task[]        @relation("TaskAssignees")
  Project   Project[]     @relation("members")
  Spaces    Space[]       @relation("SpaceMembers")
  Comments  Comment[]
  SubTasks  SubTask[]     @relation("SubTaskAssignees")
}

enum UserRole {
  ADMIN
  LEAD
  MEMBER
}

/// GitHub repository linked to a project
model Repository {
  id           String        @id @default(cuid())
  githubId     Int           @unique
  name         String
  url          String
  space        Space         @relation(fields: [spaceId], references: [id])
  spaceId      String        @unique
  branches     Branch[]
  pullRequests PullRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Branches within a repository
model Branch {
  id           String        @id @default(cuid())
  name         String
  repo         Repository    @relation(fields: [repoId], references: [id])
  repoId       String
  pullRequests PullRequest[]
  createdAt    DateTime      @default(now())
}

/// Pull Requests linked back to tasks
model PullRequest {
  id        String     @id @default(cuid())
  githubId  Int        @unique
  title     String
  url       String
  state     PRState    @default(OPEN)
  author    User       @relation(fields: [authorId], references: [id])
  authorId  String
  repo      Repository @relation(fields: [repoId], references: [id])
  repoId    String
  branch    Branch?    @relation(fields: [branchId], references: [id])
  branchId  String?
  task      Task?      @relation(fields: [taskId], references: [id])
  taskId    String?    @unique
  mergedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum PRState {
  OPEN
  CLOSED
  MERGED
}

/// Internal tasks in the DMS that map to GitHub PRs/issues
model Task {
  id          String        @id @default(cuid())
  title       String
  assignees   User[]        @relation("TaskAssignees")
  priority    TaskPriority?
  dueDate     DateTime?
  status      TaskStatus?   @default(TO_DO)
  Comments    Comment[]
  description String?
  space       Space         @relation(fields: [spaceId], references: [id])
  spaceId     String
  pr          PullRequest?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  SubTasks    SubTask[]
  order       Int           @default(autoincrement())
}

model SubTask {
  id        String        @id @default(cuid())
  title     String
  assignees User[]        @relation("SubTaskAssignees")
  dueDate   DateTime?
  status    TaskStatus    @default(TO_DO)
  priority  TaskPriority?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  task      Task          @relation(fields: [taskId], references: [id])
  taskId    String
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  COMPLETE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
